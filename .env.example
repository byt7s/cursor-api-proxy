# Optional: protect the proxy so only your services can call it
# Accepts Authorization: Bearer <key> or x-api-key: <key> (Anthropic SDK style).
# CURSOR_BRIDGE_API_KEY=your-secret-key

# Recommended: a dedicated key for the dashboard, so admin actions (create /
# remove accounts, attach Cursor keys, reset HWID, restart) do not share a
# credential with LLM traffic. When set, it is the only key the dashboard
# accepts besides admin-scoped entries below.
# CURSOR_BRIDGE_DASHBOARD_KEY=another-secret-key

# Optional: several labelled keys with a scope — label:scope:key, comma separated.
# scope=chat  → LLM routes only
# scope=admin → LLM routes plus dashboard sensitive reads/mutations and /metrics
# CURSOR_BRIDGE_API_KEYS=ci:chat:sk-ci-key,ops:admin:sk-ops-key

# Optional: per-key throttle (fixed 60s window). 0 disables; over the limit the
# proxy answers 429 with Retry-After.
# CURSOR_BRIDGE_KEY_RATE_LIMIT_PER_MIN=0

# Optional: JSONL audit trail of every mutating dashboard call (including
# refused ones). Never contains key material.
# CURSOR_BRIDGE_AUDIT_LOG=~/.cursor-api-proxy/audit.jsonl
# CURSOR_BRIDGE_AUDIT_LOG_ENABLED=true
# CURSOR_BRIDGE_AUDIT_LOG_MAX_BYTES=8388608

# Optional: request hardening
# Reject JSON bodies over this size with 413 (0 disables the check).
# CURSOR_BRIDGE_MAX_BODY_BYTES=8388608
# Browser cross-origin access; empty (default) emits no CORS headers. Use * to
# allow any origin, or list exact origins.
# CURSOR_BRIDGE_CORS_ORIGINS=http://localhost:5173

# Optional JSON config file, read at startup. Anything set here or in the shell
# still wins over it; credentials in the file are refused, not ignored.
# CURSOR_BRIDGE_CONFIG_FILE=~/.cursor-api-proxy/config.json

# Optional: Cursor access token for spawned agent/ACP (automation). Alias: CURSOR_AUTH_TOKEN
# CURSOR_API_KEY=

# Optional: Cursor CLI path (default: agent)
# CURSOR_AGENT_BIN=agent

# Optional: bind and port
# CURSOR_BRIDGE_HOST=127.0.0.1
# CURSOR_BRIDGE_PORT=8765

# Optional: workspace base for Cursor CLI (default: current working directory).
# When CURSOR_BRIDGE_CHAT_ONLY_WORKSPACE=false, X-Cursor-Workspace must be under this directory.
# CURSOR_BRIDGE_WORKSPACE=/path/to/your/project

# Ignored — proxy is always chat-only (ask mode); documented for discoverability only.
# CURSOR_BRIDGE_MODE=ask

# Optional: default model when request doesn't specify one
# CURSOR_BRIDGE_DEFAULT_MODEL=auto

# Optional: timeout per completion in ms
# CURSOR_BRIDGE_TIMEOUT_MS=300000

# Optional: enable Cursor Max Mode (larger context, more tool calls). Works when using
# CURSOR_AGENT_NODE/SCRIPT or Windows .cmd layout (agent.cmd with node.exe + index.js in same dir).
# CURSOR_BRIDGE_MAX_MODE=true

# Optional: pool of configuration directories for multiple accounts (comma-separated).
# Alias: CURSOR_ACCOUNT_DIRS. Auto-discovers ~/.cursor-api-proxy/accounts when unset.
# CURSOR_CONFIG_DIRS=/Users/alice/Library/Application Support/cursor-agent,/Users/bob/Library/Application Support/cursor-agent

# Optional: admission — separate planes for ACP/CLI vs in-process SDK.
# ACP/CLI (heavy children ≈ hundreds of MB): defaults 16 global / 2 per account.
# SDK (light): defaults 48 global / 12 per account — still capped for rate limits / event loop.
# Over capacity: wait ADMISSION_WAIT_MS then 503 + Retry-After. See GET /healthz admission.acp|sdk.
# CURSOR_BRIDGE_MAX_CONCURRENT_RUNS=16
# CURSOR_BRIDGE_MAX_CONCURRENT_RUNS_PER_ACCOUNT=2
# CURSOR_BRIDGE_MAX_CONCURRENT_RUNS_SDK=48
# CURSOR_BRIDGE_MAX_CONCURRENT_RUNS_PER_ACCOUNT_SDK=12
# CURSOR_BRIDGE_ADMISSION_WAIT_MS=5000

# Optional: when true and CURSOR_CONFIG_DIRS is set, run each account on a separate port
# CURSOR_BRIDGE_MULTI_PORT=true

# Optional: send prompt via stdin instead of argv (Windows-friendly)
# CURSOR_BRIDGE_PROMPT_VIA_STDIN=true

# ACP over stdio (default true): warm one agent acp per account at startup
# CURSOR_BRIDGE_USE_ACP=true
# Set false to use agent --print (spawn per request)
# CURSOR_BRIDGE_USE_ACP=false

# Optional: default execution engine (acp | sdk). Per-account override:
# ~/.cursor-api-proxy/accounts/<name>/.cursor-bridge-engine
# SDK path needs Node >=22.13 + Dashboard API key (see set-key).
# CURSOR_BRIDGE_DEFAULT_ENGINE=acp
# When CURSOR_API_KEY is set, authenticate is skipped unless you force:
# CURSOR_BRIDGE_ACP_SKIP_AUTHENTICATE=true
# Raw JSON-RPC logging (needs NODE_DEBUG=cursor-api-proxy:acp)
# CURSOR_BRIDGE_ACP_RAW_DEBUG=false

# Optional: Windows CreateProcess cmdline budget for prompt truncation
# CURSOR_BRIDGE_WIN_CMDLINE_MAX=30000
# CURSOR_AGENT_NODE=C:\Program Files\nodejs\node.exe
# CURSOR_AGENT_SCRIPT=C:\path\to\agent\index.js

# Optional: TLS (e.g. Tailscale)
# CURSOR_BRIDGE_TLS_CERT=
# CURSOR_BRIDGE_TLS_KEY=

# Optional: bridge model tool JSON → OpenAI tool_calls / Anthropic tool_use (default false)
# CURSOR_BRIDGE_TOOL_CALLS=true

# Optional: strip image parts instead of rejecting with images_not_supported (default false)
# CURSOR_BRIDGE_IGNORE_IMAGES=true

# Optional: request / traffic logging
# CURSOR_BRIDGE_SESSIONS_LOG=~/.cursor-api-proxy/sessions.log
# CURSOR_BRIDGE_VERBOSE=false

# Optional: structured request log (one JSON object per line; no prompts or keys).
# Feeds the dashboard Requests detail view (status, model, engine, account, latency spans).
# CURSOR_BRIDGE_REQUESTS_LOG=~/.cursor-api-proxy/requests.jsonl
# CURSOR_BRIDGE_REQUESTS_LOG_ENABLED=true
# Rotate to <path>.1 above this size (0 disables rotation)
# CURSOR_BRIDGE_REQUESTS_LOG_MAX_BYTES=33554432

# Optional: GET /metrics in Prometheus text format. Bearer when CURSOR_BRIDGE_API_KEY
# is set, loopback-only otherwise; false returns 404.
# CURSOR_BRIDGE_METRICS_ENABLED=true

# Isolated temp workspace (default true). Set false only if the CLI should see real paths.
# CURSOR_BRIDGE_CHAT_ONLY_WORKSPACE=true

# --- docker-compose only (ignored when running outside compose) ---
# Which host interface to bind. Default 127.0.0.1 (localhost only).
# Set to 0.0.0.0 to expose on all interfaces (LAN/Tailscale/public).
# Set to a specific IP (e.g. 100.x.x.x) to bind only that interface.
# HOST_BIND=127.0.0.1
# Host port to expose (container always listens on 8765 internally).
# HOST_PORT=8765
