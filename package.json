{
  "name": "cursor-api-proxy",
  "version": "1.3.0",
  "description": "OpenAI-compatible proxy for Cursor CLI — use Cursor models from any LLM client on localhost",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "public",
    "docs",
    "scripts/cursor-api-proxy",
    "package.json"
  ],
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cursor-api-proxy": "dist/cli.js"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "npm run build:web && tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node ./dist/cli.js",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cursor",
    "openai",
    "proxy",
    "llm",
    "api"
  ],
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "chrome-launcher": "^1.2.1"
  }
}
